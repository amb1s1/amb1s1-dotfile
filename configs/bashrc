# ~/.bashrc — interactive bash configuration (macOS: bash + brush; see README)
#
# WHY BASH: the stated reason for leaving fish was compatibility friction, and
# bash is the shell that makes compatibility a strength rather than a
# compromise — every runbook snippet, every `eval "$(tool init)"`, every vendor
# doc example runs verbatim, with no port and no `bass` wrapper.
#
# The interactive experience fish offered (autosuggestions, syntax
# highlighting, vim modes) comes from ble.sh, which is a full line editor
# written in pure bash. It is not a downgrade from fish on those axes — its
# highlighter does real syntactic analysis, including nested command
# substitutions and heredocs.
#
# IMPORTANT: on macOS this must be Homebrew bash 5.x, not /bin/bash. macOS
# ships bash 3.2 (frozen in 2007 over the GPL3 licence change) and ble.sh
# wants 4.0+.

# ---------------------------------------------------------------------------
# ble.sh — MUST be the first thing, loaded with --attach=none.
# The matching `ble-attach` is the LAST line of this file. Upstream requires
# this split so stdio stays connected to the controlling TTY.
#
# SKIPPED UNDER BRUSH. ble.sh reaches into GNU bash internals and must not load
# under a reimplementation; brush supplies its own highlighting and
# autosuggestions instead (see the brush branch further down).
#
# The discriminator is BRUSH_VERSION, *not* BASH_VERSION: brush deliberately
# reports BASH_VERSION=5.2.37 so that bash-targeted init scripts work, so a
# BASH_VERSION test would match brush and load ble.sh into it.
# ---------------------------------------------------------------------------
if [[ $- == *i* ]] && [[ -z ${BRUSH_VERSION-} ]] && [[ -r ~/.local/share/blesh/ble.sh ]]; then
  source -- ~/.local/share/blesh/ble.sh --attach=none
fi

# ---------------------------------------------------------------------------
# PATH and environment — ABOVE the interactive guard, deliberately.
#
# These must apply to EVERY shell, not just interactive ones: Hammerspoon's
# hs.execute(), launchd jobs, `bash -c`, and git hooks all spawn
# non-interactive shells. Putting PATH below the guard is the classic reason a
# command "works in my terminal but not from the app".
#
# Every mutation here is idempotent, so re-sourcing this file cannot corrupt
# PATH or duplicate entries.
# ---------------------------------------------------------------------------
# Homebrew lives in a different place on Apple Silicon, Intel Macs and Linux.
for _brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [[ -x "$_brew_prefix/bin/brew" ]]; then
    eval "$("$_brew_prefix/bin/brew" shellenv)"
    break
  fi
done
unset _brew_prefix

path_prepend() { [[ -d "$1" ]] && [[ ":$PATH:" != *":$1:"* ]] && PATH="$1:$PATH"; }

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/go/bin"
path_prepend "$HOME/.atuin/bin"
export PATH

# ---------------------------------------------------------------------------
# Secrets and machine/work-specific settings — untracked. See README.
# ---------------------------------------------------------------------------
# Credential values live in secrets.sh (mode 600) and nowhere else. If the file
# is absent the shell still works; tools that need a token complain, which is
# the right failure.
[[ -r ~/.config/bash/secrets.sh ]] && source ~/.config/bash/secrets.sh

# Work aliases, employer-specific env vars and PATH additions go in local.sh.
# It is sourced ABOVE the interactive guard on purpose: anything it adds to
# PATH must reach non-interactive shells too.
#
# CAUTION for anything you source from here: vendor "path include" snippets
# written for zsh may use zsh-only expansions like ${(%):-%N}, which raise
# "bad substitution" in bash. Prefer adding the bin/ directory directly with
# path_prepend over sourcing a foreign init file.
[[ -r ~/.config/bash/local.sh ]] && source ~/.config/bash/local.sh

# ---------------------------------------------------------------------------
# Non-secret environment
# ---------------------------------------------------------------------------
export EDITOR=vim
export VISUAL=vim
export PAGER=less
export LESS='-FRX'
export BAT_THEME=Nord

# ---------------------------------------------------------------------------
# Everything below this line is INTERACTIVE ONLY.
# Non-interactive shells stop here, having already received PATH and exports.
# ---------------------------------------------------------------------------
case $- in *i*) ;; *) return ;; esac

# ---------------------------------------------------------------------------
# Vim editing mode — set unconditionally, NOT inside the ble.sh block.
#
# ble.sh layers a much richer vi implementation on top when it is present, but
# if it is missing or fails to load you still get readline's native vi mode
# rather than silently falling back to emacs bindings. ~/.inputrc carries the
# matching `jj` binding for the same reason.
# ---------------------------------------------------------------------------
set -o vi

# ---------------------------------------------------------------------------
# Shell options
# ---------------------------------------------------------------------------
shopt -s autocd            # `..` alone changes directory
shopt -s cdspell           # fix minor typos in cd targets
shopt -s dirspell
shopt -s globstar          # ** recurses
shopt -s nocaseglob
shopt -s checkwinsize
shopt -s no_empty_cmd_completion

# History: large, deduplicated, appended not clobbered. atuin owns search, but
# a sane $HISTFILE still matters for anything reading it.
HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoreboth:erasedups   # ignore dupes AND leading-space commands
HISTIGNORE='ls:ll:cd:pwd:exit:clear:history'
HISTTIMEFORMAT='%F %T '
shopt -s histappend
shopt -s cmdhist

# ---------------------------------------------------------------------------
# Tool integrations
#
# Every one of these is the vendor's own bash snippet, pasted unmodified.
# That is the entire point of this migration.
#
# ORDER IS LOAD-BEARING. Bash has no native preexec hook, so atuin, starship
# and ble.sh all compete for PROMPT_COMMAND and the DEBUG trap. The sequence
# below is upstream's documented one, and the known failure modes are:
#
#   ble.sh sourced after atuin   -> commands stop being recorded in atuin
#   ble.sh attached before atuin -> atuin's ctrl-r binding is overwritten
#   atuin before starship        -> starship's PROMPT_COMMAND can be clobbered
#
# Hence: ble.sh source (top of file, --attach=none) -> starship -> ... ->
# atuin -> ble-attach (bottom of file). Modern atuin bundles its own
# bash-preexec, so no external ~/.bash-preexec.sh is needed.
#
# Verify after any change here:
#   exec bash -l; echo test-$RANDOM; atuin search test-   # must find it
# ---------------------------------------------------------------------------
command -v starship >/dev/null && eval "$(starship init bash)"
command -v zoxide   >/dev/null && eval "$(zoxide init bash)"
command -v direnv   >/dev/null && eval "$(direnv hook bash)"

# carapace: modern multi-command completions (kubectl, terraform, gh, aws, …).
# This is what closes bash's completion gap versus zsh.
if command -v carapace >/dev/null; then
  export CARAPACE_BRIDGES='zsh,fish,bash_completion'
  source <(carapace _carapace bash)
fi

# Homebrew's bash-completion v2, for everything carapace does not cover.
if [[ -n "${HOMEBREW_PREFIX-}" && -r "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ]]; then
  source "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
fi

# fzf keybindings (ctrl-r is handed to atuin below, ctrl-t / alt-c stay).
command -v fzf >/dev/null && eval "$(fzf --bash)"
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --inline-info'
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'

# atuin LAST among the integrations: it binds ctrl-r and up-arrow, and should
# win over fzf's ctrl-r.
command -v atuin >/dev/null && eval "$(atuin init bash --disable-up-arrow)"

# OrbStack ships a real bash init — no port needed, unlike its fish variant.
[[ -r ~/.orbstack/shell/init.bash ]] && source ~/.orbstack/shell/init.bash 2>/dev/null

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
alias ll='eza -lah --git --group-directories-first'
alias la='eza -a'
alias l='eza'
alias lt='eza --tree --level=2'
alias ls='eza'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gd='git diff'
alias gl='git log --graph --abbrev-commit --date=relative --pretty=format:"%C(auto)%h%d %s %C(dim)(%an, %ar)"'

alias cat='bat --paging=never'
alias less='bat --paging=always'

# Networking shorthands, matching the tools actually installed here.
alias ports='lsof -iTCP -sTCP:LISTEN -P -n'
alias myip='curl -s https://ifconfig.me; echo'
alias mtrr='mtr -rwzbc 100'

# Safety: these are interactive-only aliases, so scripts are unaffected.
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# ---------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------
mkcd() { mkdir -p -- "$1" && cd -- "$1" || return; }

backup() { cp -a -- "$1" "$1.backup-$(date +%Y%m%d-%H%M%S)"; }

# Serial console, matching the Hammerspoon usbconsole module's default baud.
console() {
  local tty="${1:-$(ls -t /dev/tty.usb* 2>/dev/null | head -1)}"
  [[ -n "$tty" ]] || { echo "no /dev/tty.usb* found" >&2; return 1; }
  echo "connecting to $tty at ${2:-9600} (ctrl-a ctrl-x to exit)"
  picocom -b "${2:-9600}" "$tty"
}

# ---------------------------------------------------------------------------
# ble.sh configuration — the fish-like layer
# ---------------------------------------------------------------------------
if [[ ${BLE_VERSION-} ]]; then
  bleopt default_keymap=vi

  # 'jj' leaves insert mode — the fish binding, ported.
  # The readline equivalent for the no-ble.sh case lives in ~/.inputrc.
  ble-bind -m vi_imap -f 'j j' vi_imap/normal-mode

  # Autosuggestion from history, fish-style, accepted with the right arrow.
  bleopt complete_auto_complete=1
  bleopt complete_auto_history=1
  bleopt complete_ambiguous=1
  ble-bind -m vi_imap -f 'C-f' 'auto_complete/insert'

  # Report elapsed time for slow commands — replaces the fish `done` plugin.
  bleopt exec_elapsed_mark='%s'
  bleopt exec_errexit_mark=$'\e[91m[exit %d]\e[m'

  # Nord-ish faces, consistent with BAT_THEME.
  ble-face -s syntax_command       fg=blue
  ble-face -s syntax_quoted        fg=yellow
  ble-face -s syntax_error         fg=red
  ble-face -s syntax_comment       fg=240
  ble-face -s syntax_delimiter     fg=cyan
  ble-face -s auto_complete        fg=240
  ble-face -s region_match         bg=24,fg=white
fi

# ---------------------------------------------------------------------------
# brush — the interactive shell in Ghostty (macOS). bash remains the system
# shell everywhere.
#
# brush provides natively what ble.sh provides for bash, so this branch is the
# counterpart to the ble.sh block at the top of the file. Both are skipped when
# the other shell is running.
#
# NOTE: highlighting and autosuggestions are enabled by FLAGS, not from here —
# `--enable-highlighting` and `--enable-zsh-hooks`, set on Ghostty's `command`
# line. They have no documented config-file equivalent, and
# ~/.config/brush/config.toml silently ignores unknown keys, so there is no way
# to set them from a config file with any confidence.
#
# --enable-zsh-hooks is what makes atuin work: without it brush never invokes
# preexec_functions, and history recording fails SILENTLY. doctor.sh asserts
# the flag is present in the Ghostty config for exactly that reason.
# ---------------------------------------------------------------------------
if [[ ${BRUSH_VERSION-} ]]; then
  # 'jj' leaves insert mode. brush implements `bind` as a real builtin and
  # accepts readline-style specs.
  bind '"jj": vi-movement-mode' 2>/dev/null

  # Warn if --enable-zsh-hooks is missing, because the only other symptom is
  # that atuin quietly stops recording and you would not notice for weeks.
  #
  # This inspects our OWN invocation via ps. Do NOT test preexec_functions
  # instead: atuin populates that array whether or not the flag is present —
  # brush simply never invokes it — so that check silently always passes.
  if command -v atuin >/dev/null 2>&1; then
    case "$(ps -o command= -p $$ 2>/dev/null)" in
      *--enable-zsh-hooks*) ;;
      *) printf '\033[33mbrush:\033[0m --enable-zsh-hooks missing — atuin is NOT recording history.\n' >&2
         printf '       Fix the `command =` line in ~/.config/ghostty/config\n' >&2 ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------
# ble-attach — MUST be the last line.
# ---------------------------------------------------------------------------
[[ ! ${BLE_VERSION-} ]] || ble-attach
