# zsh config — works on macOS and Linux

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="avit"

plugins=(git)
[ -d "$ZSH/custom/plugins/zsh-autosuggestions" ] && plugins+=(zsh-autosuggestions)
[ -d "$ZSH/custom/plugins/zsh-syntax-highlighting" ] && plugins+=(zsh-syntax-highlighting)

[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# --- Environment ------------------------------------------------------------
export LANG=en_US.UTF-8
export CLICOLOR=1
export EDITOR=nvim
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# Homebrew lives in different places on Apple Silicon, Intel Macs and Linux.
for brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [ -x "$brew_prefix/bin/brew" ]; then
    eval "$("$brew_prefix/bin/brew" shellenv)"
    break
  fi
done

# --- History ----------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY

# --- Aliases ----------------------------------------------------------------
alias vim='nvim'
alias vi='nvim'
alias ll='ls -lah'
alias gs='git status'
alias gd='git diff'

# Debian/Ubuntu ship bat as batcat to avoid a name clash.
command -v batcat >/dev/null && alias bat='batcat'

# --- fzf --------------------------------------------------------------------
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# --- Machine-specific settings ----------------------------------------------
# Anything private or host-specific (work aliases, tokens, proxies) goes in
# ~/.zshrc.local, which is not tracked by this repo.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
